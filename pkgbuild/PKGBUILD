pkgname=handoff
pkgver=0.1.0
pkgrel=1
pkgdesc='Send folders to another laptop over the local network with rsync over SSH'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'rsync' 'openssh' 'polkit')
optdepends=('ufw: open the firewall to the local network while receiving'
            'libnotify: a notification when a transfer ends')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/handoff "$pkgdir/usr/bin/handoff"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/handoff.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/handoff.svg"
  install -Dm644 "$startdir/handoff.desktop" "$pkgdir/usr/share/applications/handoff.desktop"
}
